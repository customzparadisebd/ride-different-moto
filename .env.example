# CUSTOMZ PARADISE BD — environment variables
# Copy to .env on the server, fill in real values, then: chmod 600 .env
# NEVER commit the real .env to git.

# --- Client (inlined at BUILD time — rebuild after changing) ---
VITE_SUPABASE_URL="https://your-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
VITE_SUPABASE_PROJECT_ID="your-ref"

# --- Server only (read at runtime) ---
SUPABASE_URL="https://your-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
SUPABASE_ANON_KEY="your-anon-or-publishable-key"
# SECRET. Required: admin panel, audit log writes, media route, courier booking.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret"

# --- Optional ---
# AI order extraction only; omit if unused
LOVABLE_API_KEY=""
# Rate limiting tuning
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
# Port the Node server listens on (default 3000)
PORT=3000
