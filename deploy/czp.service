##
## systemd unit for CUSTOMZ PARADISE BD (Node / node-server preset)
##
## Install:
##   sudo cp deploy/czp.service /etc/systemd/system/czp.service
##   sudo nano /etc/systemd/system/czp.service      # fix User / WorkingDirectory
##   sudo systemctl daemon-reload
##   sudo systemctl enable --now czp
##   sudo systemctl status czp
##   sudo journalctl -u czp -f                      # live logs
##
## NOTE: build first (npm ci && npm run build:node). This unit only runs the
## already-built server, so a bad build never takes the site down mid-deploy.
##

[Unit]
Description=CUSTOMZ PARADISE BD (TanStack Start SSR)
After=network-in.target network.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/var/www/czp

# .env must be KEY=VALUE lines, no `export`, no shell expansion.
# Keep it secret: chown deploy:deploy .env && chmod 600 .env
EnvironmentFile=/var/www/czp/.env
Environment=NODE_ENV=production
Environment=PORT=3000

ExecStart=/usr/bin/node /var/www/czp/.output/server/index.mjs
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=20

# Logs
StandardOutput=journal
StandardError=journal
SyslogIdentifier=czp

# Light hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
